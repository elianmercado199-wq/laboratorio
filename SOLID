class GestionVehiculos:
    def __init__(self):
        self._flota: list[Vehiculo] = []

    def agregar_vehiculo(self, vehiculo: Vehiculo):
        if isinstance(vehiculo, Vehiculo):
            self._flota.append(vehiculo)

    def generar_informe_mantenimiento(self):
        print("=== INFORME DE MANTENIMIENTO DE VEHICULOS ===")
        for i, v in enumerate(self._flota, 1):
            print(f"{i}. {v.obtener_ficha_tecnica()}")
            print(f"   Costo Final de Mantenimiento: ${v.calcular_costo_mantenimiento():.2f}")


if __name__ == "__main__":
    sistema = GestionVehiculos()
    sistema.agregar_vehiculo(Auto("Toyota", "Corolla", 15000.0, 45000.0, 5000.0))
    sistema.agregar_vehiculo(Auto("Ford", "Focus", 15000.0, 120000.0, 5000.0))
    sistema.agregar_vehiculo(Moto("Honda", "CB500", 8000.0, 105000.0, 2500.0))

    sistema.generar_informe_mantenimiento()
